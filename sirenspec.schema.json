{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SirenSpec Workflow",
  "description": "YAML-first agent orchestration workflow definition.",
  "type": "object",
  "required": ["version", "nodes"],
  "additionalProperties": false,
  "definitions": {
    "AgentNode": {
      "type": "object",
      "description": "A regular agent node that runs a single named agent and writes output to a context path.",
      "required": ["agent", "writes"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["agent"],
          "description": "Node type discriminator. Defaults to 'agent' when omitted."
        },
        "agent": {
          "type": "string",
          "description": "Agent ID from the top-level 'agents' map."
        },
        "writes": {
          "type": "string",
          "description": "Dot-notation context path where the agent's output is stored (e.g. 'output.reply', 'working.intent')."
        }
      }
    },
    "SwrmAgent": {
      "type": "object",
      "description": "An inline agent definition within a swrm node.",
      "required": ["id", "provider", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique agent identifier within the swrm node."
        },
        "provider": {
          "type": "string",
          "description": "LLM provider name (e.g. 'openai', 'anthropic', 'ollama').",
          "examples": ["openai", "anthropic", "ollama"]
        },
        "model": {
          "type": "string",
          "description": "Model name (e.g. 'gpt-4o-mini', 'claude-haiku-4-5-20251001'). Provider default used if omitted.",
          "examples": ["gpt-4o-mini", "claude-haiku-4-5-20251001"]
        },
        "prompt": {
          "type": "string",
          "description": "Prompt template sent to the agent. Supports {{ variable }} interpolation."
        },
        "guardrails": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Agent-level guardrail overrides."
        }
      }
    },
    "SwrmSynthesis": {
      "type": "object",
      "description": "Optional synthesis step that aggregates swrm agent outputs into a single response.",
      "required": ["provider", "prompt"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "description": "LLM provider name (e.g. 'openai', 'anthropic')."
        },
        "model": {
          "type": "string",
          "description": "Model name. Provider default used if omitted."
        },
        "prompt": {
          "type": "string",
          "description": "Synthesis prompt template. Can reference agent outputs via {{ <node_id>.agents.<agent_id>.output }}."
        },
        "guardrails": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Synthesis-level guardrail overrides."
        }
      }
    },
    "SwrmNode": {
      "type": "object",
      "description": "A swrm (parallel agent fan-out) node. Runs all agents concurrently and optionally synthesises their outputs.",
      "required": ["type", "agents"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["swrm"],
          "description": "Node type discriminator. Must be 'swrm'."
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of agents to run concurrently. Defaults to all agents in parallel."
        },
        "on_failure": {
          "type": "string",
          "enum": ["abort", "continue"],
          "default": "abort",
          "description": "Policy when an agent fails. 'abort' raises SwrmAgentError; 'continue' skips the failed agent."
        },
        "agents": {
          "type": "array",
          "description": "Ordered list of agents to run in parallel.",
          "minItems": 1,
          "items": { "$ref": "#/definitions/SwrmAgent" }
        },
        "synthesis": {
          "$ref": "#/definitions/SwrmSynthesis",
          "description": "Optional synthesis step. Its output becomes the node's canonical output."
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "string",
      "description": "Workflow schema version (e.g. '0.1')."
    },
    "agents": {
      "type": "object",
      "description": "Named agent definitions. Keys are agent IDs. Used by regular agent nodes.",
      "additionalProperties": {
        "type": "object",
        "required": ["model", "system"],
        "additionalProperties": false,
        "properties": {
          "model": {
            "type": "string",
            "description": "Provider URI in 'provider:model' format (e.g. 'openai:gpt-4o-mini').",
            "examples": ["openai:gpt-4o-mini", "anthropic:claude-haiku-4-5-20251001"]
          },
          "system": {
            "type": "string",
            "description": "System prompt for this agent."
          },
          "guardrails": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Agent-level guardrail overrides. Overrides global guardrails."
          }
        }
      }
    },
    "nodes": {
      "type": "object",
      "description": "Named node definitions. Keys are node IDs. Values are either agent nodes or swrm nodes.",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/definitions/AgentNode" },
          { "$ref": "#/definitions/SwrmNode" }
        ]
      }
    },
    "edges": {
      "type": "array",
      "description": "Directed edges connecting nodes.",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "description": "Source node ID." },
          "to": { "type": "string", "description": "Destination node ID." },
          "when": { "type": "string", "description": "Condition expression evaluated after the source node completes." }
        }
      }
    },
    "input": {
      "type": "object",
      "description": "Optional static input for the first node.",
      "additionalProperties": false,
      "properties": {
        "message": { "type": "string", "description": "Static user message." }
      }
    },
    "state": {
      "type": "object",
      "description": "Optional initial workflow state.",
      "additionalProperties": true,
      "properties": {
        "working": { "type": "object", "additionalProperties": true },
        "output": { "type": "object", "additionalProperties": true }
      }
    },
    "guardrails": {
      "type": "array",
      "description": "Global guardrails applied to all agents. Defaults to ['injection'] if omitted.",
      "items": {
        "type": "string",
        "enum": ["injection", "length"]
      }
    }
  }
}
